{
  "name": "zeropy",
  "productName": "ZeroPy",
  "version": "1.9.4",
  "description": "Learn Python from zero: short lessons, real practice, instant feedback. Works offline.",
  "author": "Prafix",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/notices.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "desktop": "npm run build && electron .",
    "desktop:icon": "electron desktop/make-icon.cjs",
    "desktop:dist": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/js-yaml": "^4.0.9",
    "@types/three": "^0.187.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "gsap": "^3.15.1",
    "js-yaml": "^5.5.0",
    "marked": "^18.1.3",
    "pyodide": "^314.0.7",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "io.github.prafixx.zeropy",
    "productName": "ZeroPy",
    "copyright": "Copyright (c) 2026 Prafix",
    "directories": {
      "output": "release",
      "buildResources": "desktop"
    },
    "files": [
      "dist/**/*",
      "!dist/assets/*.woff",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icon.ico",
      "legalTrademarks": ""
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "ZeroPy",
      "artifactName": "ZeroPy-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "ZeroPy-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Prafixx",
        "repo": "zeropy",
        "releaseType": "release"
      }
    ],
    "afterPack": "desktop/after-pack.cjs"
  }
}
